{
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Business name"
    },
    "logo_url": {
      "type": "string"
    },
    "floor_plan_url": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "setup_complete": {
      "type": "boolean",
      "default": false
    },
    "open_procedures": {
      "type": "string"
    },
    "close_procedures": {
      "type": "string"
    },
    "linked_customer_app_id": {
      "type": "string"
    },
    "default_location_id": {
      "type": "string"
    },
    "stripe_connected_account_id": {
      "type": "string",
      "description": "Server-managed Stripe Connect account ID",
      "rls": {
        "write": false
      }
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    },
    "stripe_charges_enabled": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    },
    "stripe_payouts_enabled": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    },
    "stripe_transfers_enabled": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer used for Concierge Pro Billing",
      "rls": {
        "write": false
      }
    },
    "stripe_subscription_id": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "stripe_subscription_status": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "stripe_subscription_current_period_end": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": false
      }
    },
    "stripe_subscription_cancel_at_period_end": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": false
      }
    },
    "billing_plan": {
      "type": "string",
      "enum": [
        "founding",
        "standard"
      ],
      "rls": {
        "write": false
      }
    },
    "billing_price_id": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "billing_location_quantity": {
      "type": "number",
      "default": 1,
      "rls": {
        "write": false
      }
    },
    "founding_started_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": false
      }
    },
    "founding_expires_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": false
      }
    },
    "platform_fee_percent": {
      "type": "number",
      "default": 4,
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "data.vendor_role": "manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "data.vendor_role": "manager"
              }
            }
          ]
        }
      ]
    }
  }
}