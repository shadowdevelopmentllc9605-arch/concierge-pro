{
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Business name"
    },
    "logo_url": {
      "type": "string",
      "description": "Business logo/picture URL"
    },
    "floor_plan_url": {
      "type": "string",
      "description": "Floor plan image URL"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Base44 user ID of the business owner"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the business owner"
    },
    "tax_rate": {
      "type": "number",
      "default": 0,
      "description": "Store sales-tax rate as a percentage, e.g. 7.25"
    },
    "setup_complete": {
      "type": "boolean",
      "default": false
    },
    "open_procedures": {
      "type": "string",
      "description": "Opening procedures text"
    },
    "close_procedures": {
      "type": "string",
      "description": "Closing procedures text"
    },
    "linked_customer_app_id": {
      "type": "string",
      "description": "Link to customer-facing Concierge app"
    },
    "default_location_id": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "data.vendor_role": "manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "data.vendor_role": "manager"
              }
            }
          ]
        }
      ]
    }
  }
}
