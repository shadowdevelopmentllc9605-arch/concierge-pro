{
  "name": "StoreVisit",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "external_checkin_id": {
      "type": "string"
    },
    "entered_at": {
      "type": "string",
      "format": "date-time"
    },
    "exited_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed"
      ],
      "default": "active"
    },
    "purchase_id": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "customer_id",
    "entered_at"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "read": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "update": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "delete": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.vendor_role": "manager"
          }
        }
      ]
    }
  }
}
