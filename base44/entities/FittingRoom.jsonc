{
  "name": "FittingRoom",
  "type": "object",
  "properties": {
    "room_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "occupied",
        "cleaning"
      ],
      "default": "available"
    },
    "customer_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Item IDs in the room"
    },
    "suggested_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Items cast to mirror"
    },
    "business_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    }
  },
  "required": [
    "room_number"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.vendor_role": "manager"
          }
        }
      ]
    },
    "read": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "update": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "delete": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.vendor_role": "manager"
          }
        }
      ]
    }
  }
}