{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "cost": {
      "type": "number"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "depth": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "default": "inches"
        }
      }
    },
    "stock_quantity": {
      "type": "number",
      "default": 0
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 5
    },
    "floor_position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "business_id": {
      "type": "string"
    },
    "linked_product_id": {
      "type": "string",
      "description": "ID from customer app for linking"
    },
    "location_id": {
      "type": "string"
    },
    "tryOn_image": {
      "type": "string",
      "description": "Transparent garment image for customer virtual try-on"
    },
    "size_chart": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "chest_min_cm": {
            "type": "number"
          },
          "chest_max_cm": {
            "type": "number"
          },
          "waist_min_cm": {
            "type": "number"
          },
          "waist_max_cm": {
            "type": "number"
          },
          "hips_min_cm": {
            "type": "number"
          },
          "hips_max_cm": {
            "type": "number"
          },
          "inseam_min_cm": {
            "type": "number"
          },
          "inseam_max_cm": {
            "type": "number"
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "stock_quantity": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "brand": {
      "type": "string"
    },
    "style_type": {
      "type": "string",
      "enum": [
        "business",
        "casual",
        "nightlife",
        "trendy"
      ]
    },
    "processed_stock_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.vendor_role": "manager"
              }
            },
            {
              "user_condition": {
                "data.vendor_permissions.manage_inventory": true
              }
            }
          ]
        }
      ]
    },
    "read": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "update": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.vendor_role": "manager"
              }
            },
            {
              "user_condition": {
                "data.vendor_permissions.manage_inventory": true
              }
            },
            {
              "user_condition": {
                "data.vendor_permissions.edit_floor_plan": true
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.vendor_role": "manager"
              }
            },
            {
              "user_condition": {
                "data.vendor_permissions.manage_inventory": true
              }
            }
          ]
        }
      ]
    }
  }
}
