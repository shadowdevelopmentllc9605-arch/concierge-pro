{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "inventory_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit_card",
        "debit_card",
        "mobile_pay"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "refunded"
      ],
      "default": "pending"
    },
    "business_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "external_purchase_id": {
      "type": "string"
    },
    "synced_to_customer": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_id",
    "total"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.vendor_role": "manager"
              }
            },
            {
              "user_condition": {
                "data.vendor_permissions.process_checkout": true
              }
            }
          ]
        }
      ]
    },
    "read": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "update": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.vendor_role": "manager"
              }
            },
            {
              "user_condition": {
                "data.vendor_permissions.process_checkout": true
              }
            }
          ]
        }
      ]
    },
    "delete": false
  }
}
