{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "inventory_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "width_code": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit_card",
        "debit_card",
        "mobile_pay"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "refunded",
        "cancelled"
      ],
      "default": "pending"
    },
    "business_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "external_purchase_id": {
      "type": "string"
    },
    "synced_to_customer": {
      "type": "boolean",
      "default": false
    },
    "sync_error": {
      "type": "string"
    },
    "payment_provider": {
      "type": "string"
    },
    "payment_intent_id": {
      "type": "string"
    },
    "shipping": {
      "type": "number",
      "default": 0
    },
    "concierge_attributed": {
      "type": "boolean",
      "default": false
    },
    "attribution_source": {
      "type": "string",
      "enum": [
        "concierge_online",
        "concierge_store_visit",
        "none"
      ],
      "default": "none"
    },
    "attribution_event_id": {
      "type": "string"
    },
    "platform_fee_percent": {
      "type": "number",
      "default": 4
    },
    "platform_fee_amount": {
      "type": "number",
      "default": 0
    },
    "platform_fee_invoice_item_id": {
      "type": "string"
    },
    "platform_fee_status": {
      "type": "string",
      "enum": [
        "collected",
        "accrued",
        "waived",
        "partially_refunded",
        "refunded",
        "not_applicable"
      ],
      "default": "not_applicable"
    }
  },
  "required": [
    "customer_id",
    "total"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.vendor_role": "manager"
          }
        }
      ]
    },
    "read": {
      "data.business_id": "{{user.data.business_id}}"
    },
    "update": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.vendor_role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.vendor_role": "manager"
          }
        }
      ]
    }
  }
}