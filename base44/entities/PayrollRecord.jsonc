{
  "name": "PayrollRecord",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "pay_period_start": {
      "type": "string",
      "format": "date"
    },
    "pay_period_end": {
      "type": "string",
      "format": "date"
    },
    "regular_hours": {
      "type": "number",
      "default": 0
    },
    "overtime_hours": {
      "type": "number",
      "default": 0
    },
    "gross_pay": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "employee_id",
    "pay_period_start",
    "pay_period_end"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.vendor_role": "manager"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.vendor_role": "manager"
              }
            },
            {
              "user_condition": {
                "data.vendor_permissions.view_payroll": true
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.vendor_role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.vendor_role": "manager"
          }
        }
      ]
    }
  }
}
